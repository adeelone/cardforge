# CardForge does not require any environment variables to build or run.
# Add no client-side secrets: Vite exposes VITE_* values to the browser bundle.

# Optional. Overrides the canonical site origin used in generated canonical/Open Graph
# metadata, sitemap.xml, robots.txt, llms.txt, and security.txt (see src/app/seo.tsx and
# scripts/postbuild.mjs). Defaults to https://adeelone.github.io/cardforge when unset.
# VITE_SITE_ORIGIN=https://your-domain.example
